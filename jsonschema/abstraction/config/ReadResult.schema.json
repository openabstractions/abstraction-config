{
  "$defs": {
    "ConfigSource": {
      "additionalProperties": true,
      "properties": {
        "location": {
          "enum": [
            "machine",
            "user",
            "process"
          ],
          "type": "string"
        },
        "path": {
          "maxLength": 4096,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$",
          "type": "string"
        }
      },
      "required": [
        "location",
        "path"
      ],
      "type": "object"
    },
    "Entry": {
      "additionalProperties": true,
      "properties": {
        "key": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.-]*$",
          "type": "string"
        },
        "origin": {
          "$ref": "#/$defs/KeyOrigin"
        },
        "value": {
          "$ref": "#/$defs/Value"
        }
      },
      "required": [
        "key",
        "origin"
      ],
      "type": "object"
    },
    "IgnoredField": {
      "additionalProperties": true,
      "properties": {
        "name_excerpt": {
          "maxLength": 64,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$",
          "type": "string"
        },
        "offset": {
          "maximum": 262144,
          "minimum": 0,
          "type": "integer"
        },
        "reason": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/ConfigSource"
        }
      },
      "required": [
        "offset",
        "name_excerpt",
        "reason",
        "source"
      ],
      "type": "object"
    },
    "KeyOrigin": {
      "additionalProperties": true,
      "properties": {
        "location": {
          "enum": [
            "machine",
            "user",
            "process"
          ],
          "type": "string"
        },
        "path": {
          "maxLength": 4096,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$",
          "type": "string"
        },
        "reason": {
          "maxLength": 512,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$",
          "type": "string"
        },
        "shadowed": {
          "items": {
            "$ref": "#/$defs/ConfigSource"
          },
          "maxItems": 3,
          "type": "array"
        },
        "state": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "state"
      ],
      "type": "object"
    },
    "KeyProblem": {
      "additionalProperties": true,
      "properties": {
        "key": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.-]*$",
          "type": "string"
        },
        "reason": {
          "maxLength": 512,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$",
          "type": "string"
        }
      },
      "required": [
        "key",
        "reason"
      ],
      "type": "object"
    },
    "KeyRefusal": {
      "additionalProperties": true,
      "properties": {
        "key": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.-]*$",
          "type": "string"
        },
        "reason": {
          "enum": [
            "not_granted",
            "unknown_key"
          ],
          "type": "string"
        },
        "refusal": {
          "$ref": "#/$defs/rights.RefusalDetail"
        }
      },
      "required": [
        "key",
        "reason"
      ],
      "type": "object"
    },
    "Value": {
      "additionalProperties": false,
      "properties": {
        "boolean": {
          "type": "boolean"
        },
        "bytes": {
          "maximum": 9223372036854775807,
          "minimum": -9223372036854775808,
          "type": "integer"
        },
        "choice": {
          "pattern": "^[A-Za-z0-9_.-]*$",
          "type": "string"
        },
        "duration_ms": {
          "maximum": 9223372036854775807,
          "minimum": -9223372036854775808,
          "type": "integer"
        },
        "integer": {
          "maximum": 9223372036854775807,
          "minimum": -9223372036854775808,
          "type": "integer"
        },
        "kind": {
          "enum": [
            "boolean",
            "integer",
            "bytes",
            "duration",
            "text",
            "choice",
            "text_list",
            "text_map",
            "unlimited"
          ],
          "type": "string"
        },
        "text": {
          "maxLength": 4096,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$",
          "type": "string"
        },
        "text_list": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$",
            "type": "string"
          },
          "maxItems": 128,
          "type": "array"
        },
        "text_map": {
          "additionalProperties": {
            "maxLength": 512,
            "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$",
            "type": "string"
          },
          "maxProperties": 8,
          "propertyNames": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.-]*$",
            "type": "string"
          },
          "type": "object"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "rights.RefusalDetail": {
      "additionalProperties": true,
      "properties": {
        "action": {
          "type": "string"
        },
        "ask": {
          "enum": [
            "available",
            "none"
          ],
          "type": "string"
        },
        "credential": {
          "type": "string"
        },
        "decision": {
          "enum": [
            "denied",
            "not_granted",
            "person_only"
          ],
          "type": "string"
        },
        "question": {
          "type": "string"
        },
        "retry_after_ms": {
          "maximum": 86400000,
          "minimum": 0,
          "type": "integer"
        },
        "source": {
          "type": "string"
        }
      },
      "required": [
        "source",
        "decision",
        "ask"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "corrupt_offset": {
      "maximum": 262144,
      "minimum": 0,
      "type": "integer"
    },
    "corrupt_source": {
      "$ref": "#/$defs/ConfigSource"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/Entry"
      },
      "maxItems": 64,
      "type": "array"
    },
    "ignored_fields": {
      "items": {
        "$ref": "#/$defs/IgnoredField"
      },
      "maxItems": 16,
      "type": "array"
    },
    "ignored_omitted": {
      "maximum": 262144,
      "minimum": 0,
      "type": "integer"
    },
    "outcome": {
      "enum": [
        "read",
        "corrupt",
        "not_permitted",
        "unavailable",
        "invalid",
        "forbidden"
      ],
      "type": "string"
    },
    "problem": {
      "$ref": "#/$defs/KeyProblem"
    },
    "refusal": {
      "$ref": "#/$defs/rights.RefusalDetail"
    },
    "refused": {
      "items": {
        "$ref": "#/$defs/KeyRefusal"
      },
      "maxItems": 64,
      "type": "array"
    },
    "revision": {
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_.-]*$",
      "type": "string"
    }
  },
  "required": [
    "outcome",
    "entries",
    "revision"
  ],
  "title": "ReadResult",
  "type": "object"
}
