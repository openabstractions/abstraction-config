{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "key": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.-]*$",
      "type": "string"
    },
    "reason": {
      "maxLength": 512,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$",
      "type": "string"
    }
  },
  "required": [
    "key",
    "reason"
  ],
  "title": "KeyProblem",
  "type": "object"
}
