{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "location": {
      "enum": [
        "machine",
        "user",
        "process"
      ],
      "type": "string"
    },
    "path": {
      "maxLength": 4096,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$",
      "type": "string"
    }
  },
  "required": [
    "location",
    "path"
  ],
  "title": "ConfigSource",
  "type": "object"
}
